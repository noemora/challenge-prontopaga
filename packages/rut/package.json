{
  "name": "@riesgo/rut",
  "version": "1.0.0",
  "private": true,
  "description": "Validacion, normalizacion y comparacion de RUT chileno (modulo 11). Compartido entre API y SPA.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
