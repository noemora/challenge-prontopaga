# ─── Servidor ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Secreto de firma HS256. OBLIGATORIO, minimo 32 caracteres.
# Generar uno propio con:  openssl rand -base64 48
# Nunca commitear el valor real: este archivo es solo la plantilla.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32-o-mas
JWT_EXPIRES_IN=15m
JWT_ISSUER=prontopaga-riesgo-api
JWT_AUDIENCE=prontopaga-riesgo-web

# ─── CORS ────────────────────────────────────────────────────────────────────
# Lista blanca separada por comas. Sin comodines.
# localhost y 127.0.0.1 son origenes distintos para el navegador: van los dos.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Valor para `trust proxy` de Express. Dejar VACIO si no hay un proxy de
# confianza por delante. Detras de un balanceador: "1", "loopback" o la subred.
TRUST_PROXY=

# ─── Rate limiting de /login ─────────────────────────────────────────────────
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=10

# ─── Observabilidad ──────────────────────────────────────────────────────────
LOG_LEVEL=info
